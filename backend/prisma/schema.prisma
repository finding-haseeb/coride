generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: chat-worker/prisma/schema.prisma must stay identical to this file.

model User {
  id            String   @id @default(uuid())
  name          String
  username      String   @unique
  email         String   @unique
  password      String?
  profile_image String?
  about         String?
  bio           String?
  images        String[]
  trips         Trip[]   @relation("UserTrips")
  tripHistory   TripHistory[] @relation("UserTripHistory")
  recurringTrips RecurringTrip[]
  ratings       Float      @default(0)
  ratingCount   Int      @default(0)
  json          Json?    @default("{}")
  createdAt     DateTime @default(now())

  // Profile details used by match filters
  gender        String?  // "female" | "male" | "other"
  birthYear     Int?
  interests     String[] // short tags, used for smart matching and icebreakers

  // Email verification
  emailVerified   Boolean   @default(false)
  verifyToken     String?   @unique
  verifyExpiresAt DateTime?

  // Safety: [{ name, phone }]
  emergencyContacts Json? @default("[]")

  writtenReviews  Review[] @relation("WrittenReviews")
  receivedReviews Review[] @relation("ReceivedReviews")

  sentFriendRequests     Friendship[] @relation("SentFriendRequests")
  receivedFriendRequests Friendship[] @relation("ReceivedFriendRequests")

  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")

  notifications   Notification[]
  reportsMade     Report[] @relation("ReportsMade")
  reportsReceived Report[] @relation("ReportsReceived")
  blocksMade      Block[]  @relation("BlocksMade")
  blockedBy       Block[]  @relation("BlockedBy")
  groupsCreated   RideGroup[]
  groupMemberships GroupMember[]
  groupMessages   GroupMessage[]
}

model Friendship {
  id        String   @id @default(uuid())
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester   User   @relation("SentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String

  receiver   User   @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String

  blockedBy  String?

  @@unique([requesterId, receiverId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Trip {
  id           String   @id @default(uuid())
  user         User     @relation("UserTrips", fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  startTime    DateTime
  stationList  Int[]
  length       Int
  startStation Int
  endStation   Int
  distanceKm   Float?
}

model TripHistory {
  id           String   @id @default(uuid())
  user         User     @relation("UserTripHistory", fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  startTime    DateTime
  stationList  Int[]
  length       Int
  startStation Int
  endStation   Int
  distanceKm   Float?
  archivedAt   DateTime @default(now())
}

// A trip the user takes on a weekly schedule, e.g. Mon-Fri at 09:15.
model RecurringTrip {
  id               String   @id @default(uuid())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  days             Int[]    // 0 = Sunday ... 6 = Saturday (India time)
  departureMinutes Int      // minutes after midnight, India time
  stationList      Int[]
  length           Int
  startStation     Int
  endStation       Int
  distanceKm       Float?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([userId])
}

model Review {
  id        String   @id @default(uuid())
  rating    Float
  comment   String?
  createdAt DateTime @default(now())

  reviewer   User   @relation("WrittenReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId String

  reviewee   User   @relation("ReceivedReviews", fields: [revieweeId], references: [id], onDelete: Cascade)
  revieweeId String

  @@index([revieweeId])
  @@index([reviewerId])
}

model ChatMessage {
  id              String   @id @default(uuid())
  message         String
  clientTimestamp BigInt?
  createdAt       DateTime @default(now())
  readAt          DateTime?

  sender          User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderId        String

  receiver        User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId      String

  @@index([senderId, receiverId])
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String   // FRIEND_REQUEST | FRIEND_ACCEPTED | REVIEW | SOS | GROUP_INVITE | SYSTEM
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Report {
  id         String   @id @default(uuid())
  reporter   User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  reported   User     @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reportedId String
  reason     String
  details    String?
  status     String   @default("OPEN")
  // Filled by AI triage (or the rule-based fallback); an admin still decides.
  riskScore  Int?
  riskLabel  String?
  riskReason String?
  createdAt  DateTime @default(now())

  @@index([reportedId])
}

model Block {
  id        String   @id @default(uuid())
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model RideGroup {
  id          String   @id @default(uuid())
  name        String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())

  members  GroupMember[]
  messages GroupMessage[]
}

model GroupMember {
  id       String    @id @default(uuid())
  group    RideGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id              String    @id @default(uuid())
  group           RideGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId         String
  sender          User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId        String
  message         String
  clientTimestamp BigInt?
  createdAt       DateTime  @default(now())

  @@index([groupId, createdAt])
}
